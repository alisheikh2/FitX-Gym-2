# ---- Server environment ----
# Copy to .env and fill in. Never commit real values.

# MongoDB connection. Leave empty in local development to auto-start an
# embedded MongoDB (mongodb-memory-server) with a persistent .dbdata directory.
MONGODB_URI=

# JWT signing secret — use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# Port for the API server
PORT=5000

# Comma-separated allowed origins for CORS (the client URL(s))
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Optional integrations (not required for MVP)
# EMAIL_USER=
# EMAIL_PASS=
# CLOUDINARY_URL=

# ---- Lead notification emails (Resend) ----
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Where new "Book a Consultation" form leads get emailed
LEAD_NOTIFY_EMAIL=zohaibalifitness@gmail.com
# Sender shown in the email. Until you verify your own domain on Resend,
# this MUST stay onboarding@resend.dev (Resend's shared test sender) and
# LEAD_NOTIFY_EMAIL must be the same address you signed up to Resend with.
RESEND_FROM_EMAIL=FITX Website <onboarding@resend.dev>
