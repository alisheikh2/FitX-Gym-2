# ---- Server environment ----
# Copy to .env and fill in. Never commit real values.

# MongoDB connection. Leave empty in local development to auto-start an
# embedded MongoDB (mongodb-memory-server) with a persistent .dbdata directory.
MONGODB_URI=

# JWT signing secret — use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# Port for the API server
PORT=5000

# Comma-separated allowed origins for CORS (the client URL(s))
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Optional integrations (not required for MVP)
# EMAIL_USER=
# EMAIL_PASS=
# CLOUDINARY_URL=
